---
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import TerminalDemo from "../components/home/TerminalDemo.astro";
import TwoViews from "../components/home/TwoViews.astro";
import Features from "../components/home/Features.astro";
import Speed from "../components/home/Speed.astro";
import ForAgents from "../components/home/ForAgents.astro";
import Cta from "../components/home/Cta.astro";
import { site } from "../config/site";
import { homeJsonLd } from "../config/jsonLd";
---
<Base title={site.name} description={site.description} path="/" jsonLd={homeJsonLd}>
  <Hero />
  <TerminalDemo />
  <TwoViews />
  <Features />
  <Speed />
  <ForAgents />
  <Cta />
</Base>
