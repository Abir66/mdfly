---
import Section from "../Section.astro";
import InstallTabs from "../InstallTabs.astro";
import ArrowLink from "../ArrowLink.astro";
import { docsHref } from "../../config/site";
---
<div class="relative isolate overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute top-1/2 left-1/2 -z-10 h-[28rem] w-[min(48rem,100%)] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent-soft blur-3xl"></div>
  <Section id="get-started" class="reveal flex flex-col items-center text-center">
    <h2 class="font-display text-5xl font-extrabold leading-[0.95] tracking-tight text-balance sm:text-7xl">Publish your first link.</h2>
    <div class="mt-10 w-full max-w-xl">
      <InstallTabs id="cta" />
    </div>
    <ArrowLink href={docsHref} class="mt-8 text-sm font-medium">Read the docs</ArrowLink>
  </Section>
</div>
