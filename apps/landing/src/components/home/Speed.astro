---
import Section from "../Section.astro";

const points = [
  { title: "Zero setup", body: "Install and publish. There is no config file." },
  { title: "Only changes upload", body: "Files are content-hashed, so an update uploads only the ones that changed." },
  { title: "Served from the edge", body: "Files are cached on Cloudflare's network." },
  { title: "Straight to your clipboard", body: "", code: "mdfly publish notes.md | pbcopy" },
];
---
<Section id="speed" class="reveal">
  <h2 class="max-w-2xl font-display text-4xl font-extrabold leading-[0.95] tracking-tight text-balance sm:text-5xl">Fast because there's nothing in the way.</h2>

  <ul class="mt-12 grid grid-cols-1 border-y border-line sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
    {points.map((p) => (
      <li class="border-b border-line py-6 last:border-b-0 sm:px-6 sm:first:pl-0 lg:border-b-0 lg:border-l lg:first:border-l-0 lg:py-8">
        <h3 class="font-display text-xl font-extrabold tracking-tight">{p.title}</h3>
        {p.body && <p class="mt-2 text-pretty text-muted">{p.body}</p>}
        {p.code && <code class="mt-3 block overflow-x-auto whitespace-nowrap font-mono text-xs text-accent">{p.code}</code>}
      </li>
    ))}
  </ul>
</Section>
