---
import Section from "../Section.astro";
import CopyButton from "../CopyButton.astro";
import { docUrl, rawCurl, rawUrl } from "../../config/site";
import SampleDocBody from "./SampleDocBody.astro";
import { sampleDocMarkdown } from "../../config/sampleDoc";

const curl = rawCurl();
const markdown = sampleDocMarkdown();
---
<Section id="two-views" class="reveal overflow-x-clip">
  <div class="max-w-2xl">
    <h2 class="font-display text-4xl font-extrabold leading-[0.95] tracking-tight text-balance sm:text-5xl">Same document. Two ways to read it.</h2>
    <p class="mt-4 text-lg text-pretty text-muted">Every link has a raw twin. People get a clean page; agents and scripts get the exact markdown.</p>
  </div>

  <div class="mt-12 grid grid-cols-1 items-start gap-8 lg:mt-16 lg:grid-cols-[minmax(0,7fr)_minmax(0,1fr)_minmax(0,5fr)] lg:gap-0">
    <div>
      <p class="mb-3 font-mono text-xs uppercase tracking-widest text-muted">For people</p>
      <figure class="overflow-hidden rounded-xl border border-line bg-bg shadow-[0_1px_0_var(--line),0_40px_80px_-40px_var(--accent-soft)]">
        <div class="flex items-center border-b border-line bg-surface px-4 py-2.5">
          <span class="truncate font-mono text-xs text-fg">{docUrl()}</span>
        </div>
        <div class="px-6 py-8 sm:px-10 sm:py-10">
          <SampleDocBody size="lg" />
        </div>
      </figure>
    </div>

    <div class="hidden self-center lg:block" aria-hidden="true">
      <svg class="h-6 w-full text-accent" viewBox="0 0 100 24" preserveAspectRatio="none" fill="none">
        <mask id="connector-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="24">
          <path class="connector-line" d="M0 12H100" pathLength="100" stroke="white" stroke-width="12" />
        </mask>
        <path d="M0 12H100" mask="url(#connector-mask)" stroke="currentColor" stroke-width="2" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />
      </svg>
    </div>

    <div class="lg:mt-10">
      <p class="mb-3 font-mono text-xs uppercase tracking-widest text-muted">For agents</p>
      <div class="overflow-hidden rounded-xl border border-term-line bg-term-bg text-term-fg">
        <div class="border-b border-term-line bg-term-bar px-4 py-2.5">
          <span class="block truncate font-mono text-xs text-term-muted">{rawUrl()}</span>
        </div>
        <pre class="whitespace-pre-wrap break-words px-5 py-5 font-mono text-xs leading-6"><code>{markdown}</code></pre>
        <div class="flex items-center justify-between gap-2 border-t border-term-line px-5 py-2.5 font-mono text-xs">
          <code class="min-w-0 truncate text-term-accent"><span class="text-term-muted" aria-hidden="true">$ </span>{curl}</code>
          <CopyButton text={curl} label="Copy raw view curl command" />
        </div>
      </div>
    </div>
  </div>
</Section>
