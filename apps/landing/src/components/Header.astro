---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../config/site";
---
<header class="sticky top-0 z-40 border-b border-line bg-bg/70 backdrop-blur">
  <div class="mx-auto flex h-14 w-full max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" aria-label={`${site.name} home`} class="rounded-md focus-visible:outline-2 focus-visible:outline-accent"><Logo /></a>
    <nav class="flex items-center gap-1" aria-label="Primary">
      {site.nav.map((item) => (
        <a href={item.href} class="rounded-md px-3 py-1.5 text-sm font-medium text-muted transition-colors hover:text-fg focus-visible:outline-2 focus-visible:outline-accent">{item.label}</a>
      ))}
      <a
        href={site.githubUrl}
        aria-label="mdFly on GitHub"
        class="inline-flex size-9 items-center justify-center rounded-md text-muted transition-colors hover:text-fg hover:bg-accent-soft focus-visible:outline-2 focus-visible:outline-accent"
      >
        <svg class="size-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a10.9 10.9 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z" />
        </svg>
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
