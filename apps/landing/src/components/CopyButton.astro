---
interface Props { text: string; label?: string }
const { text, label = "Copy" } = Astro.props;
---
<button
  type="button"
  data-copy={text}
  aria-label={label}
  class="group relative inline-flex size-8 items-center justify-center rounded-md text-muted transition-colors hover:text-fg hover:bg-accent-soft focus-visible:outline-2 focus-visible:outline-accent"
>
  <svg class="size-4 group-data-[copied]:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="9" y="9" width="13" height="13" rx="2" />
    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
  </svg>
  <svg class="hidden size-4 text-accent group-data-[copied]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 6 9 17l-5-5" />
  </svg>
  <span class="sr-only" aria-live="polite" data-copy-status></span>
</button>

<script>
  const COPIED_MS = 1500;

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    let timer: number | undefined;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
      } catch {
        return;
      }
      const status = btn.querySelector("[data-copy-status]");
      btn.setAttribute("data-copied", "");
      if (status) status.textContent = "Copied";
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.removeAttribute("data-copied");
        if (status) status.textContent = "";
      }, COPIED_MS);
    });
  });
</script>
