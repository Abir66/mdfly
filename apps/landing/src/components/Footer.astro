---
import Logo from "./Logo.astro";
import { site } from "../config/site";

const { lifetimeDays, bundleMB, files } = site.limits;
const links = [
  ...site.nav,
  { label: "GitHub", href: site.githubUrl },
  { label: "License", href: `${site.githubUrl}/blob/main/LICENSE` },
];
---
<footer class="border-t border-line bg-surface">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 py-12 sm:px-6 md:flex-row md:items-start md:justify-between">
    <div class="max-w-sm">
      <Logo />
      <p class="mt-3 text-sm text-muted">{site.description}</p>
    </div>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      {links.map((l) => (
        <a href={l.href} class="text-muted transition-colors hover:text-fg focus-visible:outline-2 focus-visible:outline-accent">{l.label}</a>
      ))}
    </nav>
  </div>
  <div class="border-t border-line">
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-1 px-4 py-4 font-mono text-xs text-muted sm:flex-row sm:justify-between sm:px-6">
      <p>Free · no account · links last {lifetimeDays} days · up to {bundleMB} MB / {files} files</p>
      <p>© {new Date().getFullYear()} {site.name}</p>
    </div>
  </div>
</footer>
