<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{if .Title}}{{.Title}}{{else}}mdfly{{end}}</title>
  {{- if .Excerpt}}
  <meta name="description" content="{{.Excerpt}}">
  {{- end}}
  {{- if .Title}}
  <meta property="og:title" content="{{.Title}}">
  {{- end}}
  {{- if .Excerpt}}
  <meta property="og:description" content="{{.Excerpt}}">
  {{- end}}
  {{- if .OGImageURL}}
  <meta property="og:image" content="{{.OGImageURL}}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{.OGImageURL}}">
  {{- end}}
  {{- if .Title}}
  <meta name="twitter:title" content="{{.Title}}">
  {{- end}}
  {{- if .Excerpt}}
  <meta name="twitter:description" content="{{.Excerpt}}">
  {{- end}}
  {{- if .CSSURL}}
  <link rel="stylesheet" href="{{.CSSURL}}">
  {{- end}}
  {{- if .RailScript}}
  {{.RailScript}}
  {{- end}}
</head>
<body>
{{- if .Tree}}
<div class="viewer">
  <header class="topbar">
    <button class="icon-btn" data-action="toggle-drawer" aria-label="Open file tree">☰</button>
    <span class="wordmark">mdFly</span>
  </header>
  <aside class="sidebar">
    <div class="sidebar-head">
      <a class="wordmark" href="/{{.Slug}}">mdFly</a>
      <button class="icon-btn" data-action="toggle-rail" aria-label="Collapse sidebar">⇔</button>
    </div>
    <nav class="tree" aria-label="Files">
      <ul>{{range .Tree.Children}}{{template "node" (node $.Slug .)}}{{end}}</ul>
    </nav>
  </aside>
  <main class="center">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      {{- range $i, $c := .Breadcrumb}}
      {{- if $i}}<span class="sep">/</span>{{end}}
      {{- if $c.IsCurrent}}<span class="current">{{if $c.Name}}{{$c.Name}}{{else}}mdFly{{end}}</span>
      {{- else}}<a href="{{href $.Slug $c.Path}}">{{if $c.Name}}{{$c.Name}}{{else}}&#8962;{{end}}</a>{{end}}
      {{- end}}
    </nav>
    {{- if .Listing}}
    <ul class="listing">
      {{- range .Listing}}
      <li><a class="{{if .IsDir}}dir{{else}}file{{end}}" href="{{href $.Slug .Path}}">{{.Name}}{{if .IsDir}}/{{end}}</a>{{if not .IsDir}}<span class="size">{{.Size}}</span>{{end}}</li>
      {{- end}}
    </ul>
    {{- end}}
    <article class="content">{{.Body}}</article>
  </main>
</div>
{{- else}}
{{.Body}}
{{- end}}
{{- if .BootScript}}
{{.BootScript}}
{{- end}}
{{- if .JSURL}}
<script src="{{.JSURL}}" defer></script>
{{- end}}
</body>
</html>
{{define "node"}}
{{- $slug := .Slug}}{{with .Node}}
{{- if .IsDir}}
<li><details{{if .Open}} open{{end}}><summary{{if .Current}} aria-current="page"{{end}}>{{.Name}}</summary>
<ul>{{range .Children}}{{template "node" (node $slug .)}}{{end}}</ul>
</details></li>
{{- else}}
<li><a class="file" href="{{href $slug .Path}}"{{if .Current}} aria-current="page"{{end}}>{{.Name}}</a></li>
{{- end}}
{{- end}}
{{- end}}
