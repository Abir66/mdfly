<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{if .Title}}{{.Title}}{{else}}mdfly{{end}}</title>
  {{- if .Excerpt}}
  <meta name="description" content="{{.Excerpt}}">
  {{- end}}
  {{- if .Title}}
  <meta property="og:title" content="{{.Title}}">
  {{- end}}
  {{- if .Excerpt}}
  <meta property="og:description" content="{{.Excerpt}}">
  {{- end}}
  {{- if .OGImageURL}}
  <meta property="og:image" content="{{.OGImageURL}}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{.OGImageURL}}">
  {{- end}}
  {{- if .Title}}
  <meta name="twitter:title" content="{{.Title}}">
  {{- end}}
  {{- if .Excerpt}}
  <meta name="twitter:description" content="{{.Excerpt}}">
  {{- end}}
  {{- if .CSSURL}}
  <link rel="stylesheet" href="{{.CSSURL}}">
  {{- end}}
  {{- if .RailScript}}
  {{.RailScript}}
  {{- end}}
</head>
<body>
{{- if .Tree}}
<div class="viewer{{if not .Sidebar}} no-sidebar{{end}}">
  {{- if .Sidebar}}
  <header class="topbar">
    <button class="icon-btn" data-action="toggle-drawer" aria-label="Open file tree">☰</button>
    <span class="wordmark">MdFly</span>
  </header>
  <aside class="sidebar">
    <div class="sidebar-head">
      <a class="wordmark" href="/">{{template "ic-logo"}}<span class="wordmark-text">MdFly</span></a>
      <button class="icon-btn" data-action="toggle-rail" aria-label="Collapse sidebar">{{template "ic-sidebar"}}</button>
    </div>
    <nav class="tree" aria-label="Files">
      <ul>{{range .Tree.Children}}{{template "node" (node $.Slug 0 .)}}{{end}}</ul>
    </nav>
  </aside>
  {{- end}}
  <main class="main-col">
  <div class="center{{if .CodeFile}} center-wide{{end}}">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      {{- range $i, $c := .Breadcrumb}}
      {{- if $i}}<span class="sep">/</span>{{end}}
      {{- if $c.IsCurrent}}<span class="current">{{if $c.Name}}{{$c.Name}}{{else}}mdFly{{end}}</span>
      {{- else}}<a href="{{href $.Slug $c.Path}}">{{if $c.Name}}{{$c.Name}}{{else}}&#8962;{{end}}</a>{{end}}
      {{- end}}
    </nav>
    {{- if .Listing}}
    <ul class="listing">
      {{- range .Listing}}
      <li><a class="{{if .IsDir}}dir{{else}}file{{end}}" href="{{href $.Slug .Path}}">{{.Name}}{{if .IsDir}}/{{end}}</a>{{if not .IsDir}}<span class="size">{{.Size}}</span>{{end}}</li>
      {{- end}}
    </ul>
    {{- end}}
    {{- if .Image}}
    <img class="asset-image" src="{{.Image.URL}}" alt="{{.Image.Name}}">
    {{- end}}
    {{- if .Download}}
    <div class="download-card">
      <p class="asset-name">{{.Download.Name}}</p>
      <p class="asset-size">{{.Download.Size}} bytes</p>
      <a class="download" href="{{.Download.URL}}" download>Download</a>
    </div>
    {{- end}}
    {{- if .CodeFile}}
    <div class="code-file">{{.Body}}</div>
    {{- else}}
    <article class="content">{{.Body}}</article>
    {{- end}}
  </div>
    <footer class="site-footer">
      <a class="footer-brand" href="/">{{template "ic-logo-footer"}}<span class="wordmark-text">MdFly</span></a>
      <nav class="footer-links" aria-label="Footer">
        <a href="https://github.com/placeholder/mdfly">GitHub</a>
      </nav>
    </footer>
  </main>
</div>
{{- else}}
{{.Body}}
{{- end}}
{{- if .BootScript}}
{{.BootScript}}
{{- end}}
{{- if .JSURL}}
<script src="{{.JSURL}}" defer></script>
{{- end}}
</body>
</html>
{{define "node"}}
{{- $slug := .Slug}}{{$depth := .Depth}}{{with .Node}}
{{- if .IsDir}}
<li class="tree-folder{{if .Open}} open{{end}}" style="--depth:{{$depth}}">
  <div class="tree-row folder-row">
    <button class="chevron" type="button" data-action="toggle-folder" aria-label="Toggle folder {{.Name}}" aria-controls="children-{{.Path}}" aria-expanded="{{if .Open}}true{{else}}false{{end}}">{{template "ic-chevron"}}</button>
    <a class="folder-link" href="{{href $slug .Path}}"{{if .Current}} aria-current="page"{{end}}>
      <span class="ticon ticon-closed">{{template "ic-folder"}}</span>
      <span class="ticon ticon-open">{{template "ic-folder-open"}}</span>
      <span class="tname">{{.Name}}</span>
    </a>
  </div>
  <ul class="tree-children" id="children-{{.Path}}">{{range .Children}}{{template "node" (node $slug (inc $depth) .)}}{{end}}</ul>
</li>
{{- else}}
<li class="tree-file" style="--depth:{{$depth}}">
  <a class="file tree-row" href="{{href $slug .Path}}"{{if .Current}} aria-current="page"{{end}}>
    <span class="chev-spacer" aria-hidden="true"></span>
    <span class="ticon">{{template "ic-file"}}</span>
    <span class="tname">{{.Name}}</span>
  </a>
</li>
{{- end}}
{{- end}}
{{- end}}
