# Copy to .env and fill in. Read by deploy/compose.yaml (`env_file: ../.env`) and
# by a local `go run` via `set -a; . ./.env; set +a`.

# Postgres is managed and off-box; sslmode=require because the hop leaves the VM.
DATABASE_URL=postgres://<user>:<password>@<host>/<db>?sslmode=require
# Password must match requirepass in deploy/redis.conf.
REDIS_URL=redis://:CHANGE_ME_LONG_RANDOM@redis:6379
BASE_URL=https://mdfly.dev

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mdfly
STORAGE_BASE_URL=https://storage.mdfly.dev

# Either empty leaves the purge drain unregistered; writes still enqueue durably.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Optional, defaults shown.
ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s
PURGE_DRAIN_INTERVAL=15m
LIFECYCLE_GC_INTERVAL=1h
ABANDON_GRACE=1h
BLOB_DELETE_GRACE=24h

# Local dev — uncomment; a repeated key wins. Empty REDIS_URL boots the limiter off.
# DATABASE_URL=postgres://mdfly:secret@localhost:5432/mdfly?sslmode=disable
# REDIS_URL=
# BASE_URL=http://localhost:8080
# R2_ENDPOINT=http://localhost:9000
# R2_ACCESS_KEY_ID=minioadmin
# R2_SECRET_ACCESS_KEY=minioadmin
# STORAGE_BASE_URL=http://localhost:9000/mdfly
