# Origin TLS terminator (ADR-0011). Terminates with the Cloudflare Origin CA cert
# so SSL/TLS mode Full (strict) has a real cert to validate; everything behind it
# speaks plain HTTP on the compose bridge network.
{
	admin off
	# Only 443 is open at the firewall, so a :80 redirect vhost is dead weight.
	auto_https disable_redirects
	log {
		output stdout
		format json
	}
}

# Cloudflare's published edge address space (https://www.cloudflare.com/ips/).
# Keep in sync with cloudflareRanges in internal/server/middleware/clientip.go.
(cloudflare_edge_only) {
	@direct not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	# A peer outside those ranges reached the origin directly, so its claim is
	# caller-supplied. The backend trusts this proxy's header unconditionally and
	# would otherwise key the rate limiter on a spoofable value (ADR-0013).
	request_header @direct -CF-Connecting-IP
}

mdfly.dev, api.mdfly.dev {
	import cloudflare_edge_only

	tls /etc/caddy/tls/origin.crt /etc/caddy/tls/origin.key {
		protocols tls1.2 tls1.3
	}

	# Both web slots, permanently (ADR-0015). A deploy starts the idle slot and
	# stops the live one; this file is never edited or reloaded by that swap.
	reverse_proxy app_blue:8080 app_green:8080 {
		# Prefer the first healthy slot rather than spreading load, so during the
		# overlap both versions are not serving at once — traffic flips at the
		# instant the outgoing slot stops. The corollary: blue always wins while
		# it is healthy, so once a deploy has swapped onto green, starting blue
		# again pulls traffic back to whatever image blue holds.
		lb_policy first

		# The gap between "slot stopped" and "health check noticed" is where a
		# swap would otherwise drop requests: a refused connection is retried
		# against the other upstream instead of surfacing as a 502.
		lb_retries 2
		lb_try_duration 5s
		lb_try_interval 250ms
		fail_duration 10s

		# /healthz is dependency-free on purpose and must stay that way: probing
		# Postgres here would let one database hiccup mark *both* slots dead and
		# turn a degraded site into a dark one.
		health_uri /healthz
		health_interval 5s
		health_timeout 2s
	}
}
