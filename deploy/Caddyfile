# Origin TLS terminator for the mdfly backend (ADR-0011).
#
# Cloudflare terminates TLS at the edge; this terminates again with the
# Cloudflare Origin CA cert, so SSL/TLS mode Full (strict) has a real cert to
# validate and a direct-to-origin caller gets a certificate no public root
# trusts. Everything behind it speaks plain HTTP on the compose bridge network.
{
	admin off
	# Only 443 is open at the VCN and OS firewall, so a :80 redirect vhost would
	# bind a port nothing can reach.
	auto_https disable_redirects
	log {
		output stdout
		format json
	}
}

# Cloudflare's published edge address space (https://www.cloudflare.com/ips/).
# Keep in sync with cloudflareRanges in internal/server/middleware/clientip.go.
(cloudflare_edge_only) {
	@direct not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	# A peer outside those ranges reached the origin directly, so its
	# CF-Connecting-IP claim is caller-supplied. Strip it: the backend trusts the
	# header from this proxy unconditionally and would otherwise key the rate
	# limiter on a spoofable value (ADR-0013).
	request_header @direct -CF-Connecting-IP
}

mdfly.dev, api.mdfly.dev {
	import cloudflare_edge_only

	tls /etc/caddy/tls/origin.crt /etc/caddy/tls/origin.key {
		protocols tls1.2 tls1.3
	}

	reverse_proxy app:8080
}
