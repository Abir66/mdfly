# mdfly production environment. Copy to deploy/.env and fill in real values.
#
# Compose loads this file from the compose file's directory for both `${...}`
# interpolation (postgres) and the app container's environment. deploy/.env is
# gitignored; this example is not — never put a real secret here.
#
# Docs: docs/deploy/oracle-vm-setup.md

# --- Postgres (compose service) -----------------------------------------------
# POSTGRES_PASSWORD and the password inside DATABASE_URL must match.
POSTGRES_DB=mdfly
POSTGRES_USER=mdfly
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM

# --- Backend: required --------------------------------------------------------
# `postgres` and `redis` are compose service names, resolved by Docker's
# embedded DNS. sslmode=disable is correct here: the hop never leaves the bridge
# network. Redis password must match requirepass in deploy/redis.conf.
DATABASE_URL=postgres://mdfly:CHANGE_ME_LONG_RANDOM@postgres:5432/mdfly?sslmode=disable
REDIS_URL=redis://:CHANGE_ME_LONG_RANDOM@redis:6379
BASE_URL=https://mdfly.dev

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mdfly
CDN_BASE_URL=https://cdn.mdfly.dev

# --- Backend: CDN purge (ADR-0012) --------------------------------------------
# Supplied by S45. Either one empty leaves the purge-drain job unregistered:
# writes still enqueue durably, nothing contacts the edge.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# --- Backend: optional, defaults shown ----------------------------------------
ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s
PURGE_DRAIN_INTERVAL=15m
LIFECYCLE_GC_INTERVAL=1h
ABANDON_GRACE=1h
BLOB_DELETE_GRACE=24h
